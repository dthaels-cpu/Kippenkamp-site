# Deze waarden stel je in bij Vercel: Project > Settings > Environment Variables.
# Zet ze NIET in GitHub. Dit bestand is enkel een voorbeeld.

# API-key uit je Resend-account (resend.com > API Keys)
RESEND_API_KEY=

# E-mailadres waar de aanvragen binnenkomen
# Zonder eigen geverifieerd domein bij Resend: het e-mailadres van je Resend-account
MAIL_TO=

# Optioneel: afzender. Alleen nodig met een eigen, bij Resend geverifieerd domein.
# MAIL_FROM=Het Kippenkamp <aanvragen@jouwdomein.be>
